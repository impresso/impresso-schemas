{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impresso.github.io/impresso-schemas/json/impresso-2/solr-indexing/semantic-enrichments/sem.root.tr-clusters.v1.schema.json",
  "title": "Text Reuse Cluster Solr Document",
  "description": "Schema for text reuse cluster documents in Solr (Impresso Project)",
  "type": "object",
  "$defs": {
    "clusterIdPattern": {
      "type": "string",
      "pattern": "^tr-[a-z]+-v[0-9]+-[0-9]+-c[0-9]+$",
      "description": "Text reuse cluster identifier pattern"
    }
  },
  "properties": {
    "id": {
      "$ref": "#/$defs/clusterIdPattern",
      "description": "Unique identifier for the text reuse cluster"
    },
    "min_date_dt": {
      "type": "string",
      "description": "Minimum date of documents in the cluster (ISO 8601 datetime format)",
      "format": "date-time"
    },
    "max_date_dt": {
      "type": "string",
      "description": "Maximum date of documents in the cluster (ISO 8601 datetime format)",
      "format": "date-time"
    },
    "cluster_size_l": {
      "type": "integer",
      "description": "Number of passages in the cluster",
      "minimum": 1
    },
    "day_delta_i": {
      "type": "integer",
      "description": "Number of days between min_date and max_date",
      "minimum": 0
    },
    "newspapers_ss": {
      "type": "array",
      "description": "List of newspaper IDs in the cluster",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "passages_ss": {
      "type": "array",
      "description": "List of passage identifiers (format: CI_ID@offset:length)",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z]-i[0-9]+@[0-9]+:[0-9]+$"
      },
      "minItems": 1
    },
    "ci_ids_ss": {
      "type": "array",
      "description": "List of content item IDs in the cluster",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z]-i[0-9]+$"
      },
      "minItems": 1
    },
    "lex_overlap_d": {
      "type": "number",
      "description": "Lexical overlap percentage",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "id",
    "min_date_dt",
    "max_date_dt",
    "cluster_size_l",
    "day_delta_i",
    "newspapers_ss",
    "passages_ss",
    "ci_ids_ss",
    "lex_overlap_d"
  ],
  "additionalProperties": true
}
