{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "New Collection Request",
  "description": "Create new collection request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "accessLevel": {
      "type": "string",
      "description": "Access level of the collection.",
      "enum": ["public", "private"]
    }
  },
  "required": ["title"]
}
