{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "title": "Full Version Details",
  "description": "Version of the API. Contains information about the current version of the API, features, etc.",
  "additionalProperties": false,
  "required": ["solr", "mysql", "version", "apiVersion", "documentsDateSpan", "newspapers", "features"],
  "properties": {
    "solr": {
      "type": "object",
      "properties": {
        "endpoints": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "mysql": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        }
      }
    },
    "version": {
      "type": "string"
    },
    "apiVersion": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "documentsDateSpan": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "newspapers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "partnerInstitutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "names": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "langCode": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": ["langCode", "name"],
              "additionalProperties": false
            }
          },
          "bitmapIndex": {
            "type": "integer"
          }
        },
        "required": ["id", "names", "bitmapIndex"],
        "additionalProperties": false
      }
    }
  }
}
