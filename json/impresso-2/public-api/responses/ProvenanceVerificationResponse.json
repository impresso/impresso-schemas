{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "ProvenanceVerificationResponse",
  "description": "Signed delivery receipts identify receiving accounts and ordered item IDs only. They do not attest item content or identify a publisher.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "claims": {
      "title": "ProvenanceVerificationClaims",
      "oneOf": [
        {
          "title": "ProvenanceVerificationApiClaims",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "iss": {
              "type": "string"
            },
            "aud": {
              "type": "string"
            },
            "iat": {
              "type": "number"
            },
            "jti": {
              "type": "string",
              "minLength": 1
            },
            "userRef": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": ["api"]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "idsHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "idsCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["iss", "aud", "iat", "jti", "userRef", "kind", "path", "idsHash", "idsCount"]
        },
        {
          "title": "ProvenanceVerificationExportClaims",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "iss": {
              "type": "string"
            },
            "aud": {
              "type": "string"
            },
            "iat": {
              "type": "number"
            },
            "jti": {
              "type": "string",
              "minLength": 1
            },
            "userRef": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": ["export"]
            },
            "exportId": {
              "type": "string",
              "minLength": 1
            },
            "idsHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "idsCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["iss", "aud", "iat", "jti", "userRef", "kind", "exportId", "idsHash", "idsCount"]
        }
      ]
    },
    "idsMatch": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": ["valid"]
}
