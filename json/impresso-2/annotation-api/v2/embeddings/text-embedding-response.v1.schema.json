{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impresso.github.io/impresso-schemas/json/impresso-2/annotation-api/v2/embeddings/text-embedding-response.v1.schema.json",
  "title": "Annotation API v2 text embedding response",
  "description": "Response body of POST /api/v2/embeddings/text/. The server sends every key listed here.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "../../../common/timestamp.v1.schema.json",
      "description": "UTC time at which the response was produced, as YYYY-MM-DDTHH:MM:SSZ."
    },
    "model_id": {
      "$ref": "../../../common/model-id.v1.schema.json#/properties/model_id",
      "description": "Slug of the model that produced the embedding, for example `emb-texts_siglip2-v0.0.1`. A new slug is issued whenever the model revision changes.",
      "examples": ["emb-docs_gte-v0.0.1", "emb-texts_openclip-v0.0.1", "emb-texts_siglip2-v0.0.1"]
    },
    "text": {
      "type": "string",
      "description": "The submitted text."
    },
    "embedding": {
      "type": "array",
      "description": "Text embedding, rounded to 5 decimals.",
      "items": {
        "type": "number"
      }
    },
    "size": {
      "type": "integer",
      "description": "Number of values in `embedding`."
    },
    "normalized": {
      "type": "boolean",
      "description": "Whether `embedding` is L2-normalised (the request's `normalize`)."
    },
    "seconds": {
      "type": "number",
      "description": "Processing time of the request, in seconds."
    }
  },
  "required": ["ts", "model_id", "text", "embedding", "size", "normalized", "seconds"]
}
