{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impresso.github.io/impresso-schemas/json/impresso-2/annotation-api/embeddings/openclip-text-response.v1.schema.json",
  "title": "Annotation API OpenCLIP text response",
  "description": "Response body of POST /api/openclip-text/.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "../../common/timestamp.v1.schema.json",
      "description": "UTC time at which the response was produced, as YYYY-MM-DDTHH:MM:SSZ."
    },
    "text": {
      "type": "string",
      "description": "The submitted text."
    },
    "embedding": {
      "type": "array",
      "description": "L2-normalised text embedding.",
      "items": {
        "type": "number"
      }
    },
    "model_id": {
      "$ref": "../../common/model-id.v1.schema.json#/properties/model_id",
      "description": "Identifier of the model that produced the response."
    },
    "size": {
      "type": "integer",
      "description": "Number of values in `embedding`."
    },
    "seconds": {
      "type": "number",
      "description": "Processing time of the request, in seconds."
    }
  },
  "required": ["embedding"]
}
