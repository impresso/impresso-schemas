{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impresso.github.io/impresso-schemas/json/impresso-2/common/data-stage.v1.schema.json",
  "title": "Data-processing stage scalar",
  "description": "Identifier of an Impresso pipeline stage that produces or consumes a versioned data release, matching `impresso_essentials.utils.DataStage`.",
  "type": "string",
  "enum": [
